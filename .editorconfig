# EditorConfig: same basic formatting in every editor (https://editorconfig.org)
root = true

# Defaults for every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java: 2 spaces to match google-java-format (Spotless, step 81)
[*.java]
indent_size = 2

# Gradle Kotlin DSL build scripts
[*.{kt,kts}]
indent_size = 4

# Markdown: two trailing spaces mean a line break, so keep them
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Windows scripts need CRLF line endings
[*.{bat,cmd}]
end_of_line = crlf
