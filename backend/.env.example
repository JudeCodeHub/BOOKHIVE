# Copy to backend/.env (git-ignored) and change values as needed.
# In dev every value has a default that matches infra/docker-compose.yml, so .env is optional.
# In prod these come from real environment variables / AWS Secrets Manager.

# The profile is not set here: dev is the default, prod sets SPRING_PROFILES_ACTIVE=prod
# as a real environment variable.

# Database
DB_URL=jdbc:postgresql://localhost:5432/bookhive
DB_USERNAME=bookhive
DB_PASSWORD=bookhive

# Server
SERVER_PORT=8080

# Frontend URLs allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (defaults: Mailpit from docker compose; read mails at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
# In prod also: MAIL_USERNAME, MAIL_PASSWORD (SMTP credentials)
# MAIL_FROM=BookHive <no-reply@bookhive.lk>
# Website address used in email links
FRONTEND_URL=http://localhost:3000

# JWT signing keys (RS256). Optional in dev: a temporary pair is generated on every start.
# Required in prod. Generate a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM text; line breaks may be written as \n. Keep the private key secret.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# JWT_KEY_ID=bookhive-1
