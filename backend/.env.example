# Copy to backend/.env (git-ignored) and change values as needed.
# In dev every value has a default that matches infra/docker-compose.yml, so .env is optional.
# In prod these come from real environment variables / AWS Secrets Manager.

# The profile is not set here: dev is the default, prod sets SPRING_PROFILES_ACTIVE=prod
# as a real environment variable.

# Database
DB_URL=jdbc:postgresql://localhost:5432/bookhive
DB_USERNAME=bookhive
DB_PASSWORD=bookhive

# Server
SERVER_PORT=8080

# Frontend URLs allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (defaults: Mailpit from docker compose; read mails at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
# In prod also: MAIL_USERNAME, MAIL_PASSWORD (SMTP credentials)
# MAIL_FROM=BookHive <no-reply@bookhive.lk>
# Website address used in email links
FRONTEND_URL=http://localhost:3000

# SMS through Notify.lk (step 311). Off by default. To try it: create a Notify.lk account,
# copy User ID and API key from its settings page, then set SMS_ENABLED=true.
# NotifyDEMO is Notify.lk's test sender; use your own approved Sender ID for real messages.
# SMS_ENABLED=false
# SMS_USER_ID=
# SMS_API_KEY=
# SMS_SENDER_ID=NotifyDEMO

# First admin, created at startup only while no admin exists. Dev already has one:
#   admin@bookhive.local / honey-hive-dev-2026  (application-dev.yml, local database only)
# In prod set these once, start the app, then remove the password from the environment.
# BOOTSTRAP_ADMIN_EMAIL=head.librarian@bookhive.lk
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Head Librarian

# JWT signing keys (RS256). Optional in dev: a temporary pair is generated on every start.
# Required in prod. Generate a pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM text; line breaks may be written as \n. Keep the private key secret.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# JWT_KEY_ID=bookhive-1

# File storage (S3 API). Defaults: SeaweedFS from docker compose (http://localhost:8333).
# In prod: S3_REGION and S3_BUCKET only; credentials come from the server's IAM role.
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=bookhive-uploads
# S3_ACCESS_KEY=bookhive
# S3_SECRET_KEY=bookhive-dev-secret

# Key that encrypts NIC numbers in the database: 32 random bytes, Base64. Dev has a default.
# Required in prod; generate with:  openssl rand -base64 32
# Keep it safe: without it the stored NICs can't be read back.
# FIELD_ENCRYPTION_KEY=

# Cloudflare Turnstile secret for public forms (contact). Dev default: Cloudflare's test key,
# which accepts every token. Prod: create a widget in the Cloudflare dashboard.
# TURNSTILE_SECRET=

# Library contact details and map pin, shown on the visit page (placeholders by default)
# LIBRARY_NAME= / LIBRARY_ADDRESS= / LIBRARY_CITY= / LIBRARY_POSTAL_CODE=
# LIBRARY_PHONE= / LIBRARY_EMAIL= / LIBRARY_LATITUDE= / LIBRARY_LONGITUDE=
