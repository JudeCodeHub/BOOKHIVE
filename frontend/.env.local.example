# Copy to frontend/.env.local (git-ignored) and change values as needed.
# Every value has a default that works with the local backend, so .env.local is optional.
#
# NEXT_PUBLIC_* values are built into the JavaScript sent to browsers: never put secrets in them.

# Backend API as the browser reaches it
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend API as the Next.js server reaches it (server-side rendering).
# Only needed when it differs from the public URL, e.g. inside Docker: http://backend:8080/api/v1
# API_URL=

# OpenAPI spec used by `pnpm api:types`
# OPENAPI_URL=http://localhost:8080/v3/api-docs

# Public address of this website, used for absolute links in page metadata (canonical URL,
# other languages, link previews). Prod: https://bookhive.lk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for public forms. Default: the test key that always passes.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
